# ─── Backend / Relayer ───────────────────────────────────────────────────────

# Relayer signing key (Sepolia-funded wallet). Never prefix with VITE_.
PRIVATE_KEY=

# Sepolia RPC URL for the backend relayer and Hardhat.
SEPOLIA_RPC=https://rpc.sepolia.org

# Deployed ConfidentialToken contract address for the backend relayer.
CONFIDENTIAL_TOKEN_ADDRESS="0xd0Ae70151b4D95C8E4629992edBfC1FA62a8C8AB"

# ─── Supabase ─────────────────────────────────────────────────────────────────

# Supabase project URL (found in Project Settings → API).
SUPABASE_URL=

# Supabase service role key (Settings → API → service_role). Never use anon key here.
SUPABASE_SERVICE_KEY=

# ─── Frontend (Vite build-time) ───────────────────────────────────────────────

# Privy app ID (from the Privy dashboard).
VITE_PRIVY_APP_ID=

# Sepolia RPC for browser-side viem / Wagmi / Nox SDK calls.
VITE_SEPOLIA_RPC=https://rpc.sepolia.org

# Deployed ConfidentialToken contract address for the frontend.
VITE_CONTRACT_ADDRESS="0xd0Ae70151b4D95C8E4629992edBfC1FA62a8C8AB"

# ─── Dev Only ─────────────────────────────────────────────────────────────────

# Override the API base URL (default: '' = same-origin via Vite proxy or Vercel routing).
# Only set this in local dev if you run the backend on a non-standard port.
# Leave UNSET in Vercel — the frontend will use relative /api/* paths automatically.
# VITE_RELAYER_URL=http://localhost:8080
