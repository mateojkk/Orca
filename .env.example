# Relayer/deployer private key. Use a Sepolia-funded key, without the 0x prefix.
PRIVATE_KEY=

# Shared Sepolia RPC URL for Hardhat and the backend relayer.
SEPOLIA_RPC=https://rpc.sepolia.org

# Deployed ConfidentialToken contract address for the backend relayer.
CONFIDENTIAL_TOKEN_ADDRESS="0x04B485F739d4226C6c0aF2789d6C035482E7E800"

# Privy app ID for the frontend.
VITE_PRIVY_APP_ID=

# Privy app secret for backend-only verification. Never prefix this with VITE_.
PRIVY_APP_SECRET=

# Sepolia RPC URL for Wagmi, Viem, and Nox SDK browser calls.
VITE_SEPOLIA_RPC=https://rpc.sepolia.org

# FastAPI relayer API base URL.
VITE_RELAYER_URL=http://localhost:8080

# Deployed ConfidentialToken contract address for the frontend.
VITE_CONFIDENTIAL_TOKEN_ADDRESS="0x04B485F739d4226C6c0aF2789d6C035482E7E800"
