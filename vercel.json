{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.py" },
    { "source": "/(.*)",       "destination": "/index.html"   }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  }
}
